@startuml automata_grupo06
skinparam shadowing false
skinparam defaultFontName Arial
skinparam state {
  BackgroundColor #EEF4FB
  BorderColor #2B6CB0
  BackgroundColor<<aceptacion>> #D1FAE5
  BorderColor<<aceptacion>> #059669
}

title Grafo de Transición AFD — BombaAutomata Grupo 06 ({2, 3, 5, 9})
hide empty description

state "q0 (inicial)" as q0
state "q1 [F]" as q1 <<aceptacion>>
state "q2 [F]" as q2 <<aceptacion>>
state "q2b [F]" as q2b <<aceptacion>>
state "q3 [F]" as q3 <<aceptacion>>
state "q4" as q4
state "q5 [F]" as q5 <<aceptacion>>

[*] --> q0
q0 --> q1 : a
q1 --> q2 : b
q2 --> q2b : b
q2b --> q2b : b
q2 --> q3 : c
q3 --> q4 : d
q4 --> q5 : t
q5 --> q5 : t

note bottom of q5
  Lenguaje unido: L = { ab*, abc, abcdt+ }
  Estados finales: F = { q1, q2, q2b, q3, q5 }
  Cualquier otra transición va a q_err (rechaza)
end note
@enduml
